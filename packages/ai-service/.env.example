# =========================
# AI Service Runtime
# =========================
PYTHONUNBUFFERED=1
OPENAI_API_KEY=

# MCP endpoint exposed by Nuxt service
# Local development:
#   MCP_SERVER_URL=http://localhost:3000/mcp
# Zeabur deployment (replace `web` with your Nuxt service name if different):
#   MCP_SERVER_URL=http://web:3000/mcp
MCP_SERVER_URL=http://localhost:3000/mcp
MCP_CONNECT_MAX_ATTEMPTS=8
MCP_CONNECT_INITIAL_DELAY_SECONDS=0.5
MCP_CONNECT_MAX_DELAY_SECONDS=5
MCP_CONNECT_TIMEOUT_SECONDS=5
