# =========================
# Core App / Auth (web service)
# =========================
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_tutor
BETTER_AUTH_SECRET=replace-with-a-strong-random-secret
NUXT_PUBLIC_BASE_URL=http://localhost:3000
# =========================
# AI LLM Backend (OpenAI-compatible API)
# Supports: OpenAI, Hermes Agent, vLLM, Ollama, etc.
# =========================
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o
AI_API_KEY=

# =========================
# Web Search API (Tavily)
# =========================
TAVILY_API_KEY=

# =========================
#Composion API Key
# gmail, google calendar, google drive, slack, notion, etc.
# =========================
COMPOSIO_API_KEY=

# =========================
# Embedding Model (semantic search)
# Supports any OpenAI-compatible embedding API
# =========================
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=

# =========================
# Google OAuth (better-auth social provider)
# =========================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =========================
# AI / LLM
# =========================
OPENAI_API_KEY=
GOOGLE_VISION_API_KEY=

# =========================
# Cloudflare R2 - Problem Images
# =========================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# =========================
# Cloudflare R2 - Class Materials
# =========================
CLASS_MATERIALS_R2_ACCOUNT_ID=
CLASS_MATERIALS_R2_ACCESS_KEY_ID=
CLASS_MATERIALS_R2_SECRET_ACCESS_KEY=
CLASS_MATERIALS_R2_BUCKET_NAME=
CLASS_MATERIALS_R2_PUBLIC_DOMAIN=

