# =========================
# Core App / Auth (web service)
# =========================
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_tutor
BETTER_AUTH_SECRET=replace-with-a-strong-random-secret
NUXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
NUXT_PUBLIC_BASE_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000

# =========================
# Open WebUI -> Nuxt MCP gateway authentication
# Use separate, long random values for each role-scoped endpoint.
# =========================
NUXT_MCP_STUDENT_GATEWAY_TOKEN=
NUXT_MCP_TEACHER_GATEWAY_TOKEN=

# =========================
# Google OAuth (better-auth social provider)
# =========================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =========================
# AI / LLM
# =========================
OPENAI_API_KEY=
GOOGLE_VISION_API_KEY=

# =========================
# Cloudflare R2 - Problem Images
# =========================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# =========================
# Cloudflare R2 - Class Materials
# =========================
CLASS_MATERIALS_R2_ACCOUNT_ID=
CLASS_MATERIALS_R2_ACCESS_KEY_ID=
CLASS_MATERIALS_R2_SECRET_ACCESS_KEY=
CLASS_MATERIALS_R2_BUCKET_NAME=
CLASS_MATERIALS_R2_PUBLIC_DOMAIN=

# =========================
# AI Service (packages/ai-service)
# =========================
PYTHONUNBUFFERED=1
MCP_SERVER_URL=http://localhost:8080/mcp
